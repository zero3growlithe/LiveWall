<Window x:Class="LiveWall.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LiveWall — desktop wallpaper"
        Height="660" Width="960"
        MinHeight="520" MinWidth="820"
        Background="#F7F7F9" Foreground="#1E1E22"
        Closing="Window_Closing"
        Deactivated="Window_Deactivated">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="LiveWall" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="TogglePauseButton" Content="Pause all" Width="112" Padding="8,5" Margin="6,0,0,0" Click="TogglePause_Click" />
                <Button Content="Diagnostics…" Width="112" Padding="8,5" Margin="6,0,0,0" Click="Diagnostics_Click" />
                <Button Content="Apply" Width="90" Padding="8,5" Margin="6,0,0,0" FontWeight="SemiBold" Click="Apply_Click" />
                <Button Content="Hide to tray" Width="112" Padding="8,5" Margin="6,0,0,0" Click="Tray_Click" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Monitors -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E1E1E6" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="PROFILES" FontSize="11" FontWeight="SemiBold" Foreground="#6A6A75" Margin="0,0,0,6" />
                        <ComboBox x:Name="ProfileComboBox" Margin="0,0,0,6" ToolTip="Saved setups, one entry per profile"
                                  SelectionChanged="ProfileComboBox_SelectionChanged" />
                        <TextBox x:Name="ProfileNameTextBox" Margin="0,0,0,6" ToolTip="Name used when saving a profile" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Save" Width="70" Padding="6,4" Click="SaveProfile_Click" />
                            <Button Content="Load" Width="70" Padding="6,4" Margin="6,0,0,0" Click="LoadProfile_Click" />
                            <Button Content="Delete" Width="70" Padding="6,4" Margin="6,0,0,0" Click="DeleteProfile_Click" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="MONITORS" FontSize="11" FontWeight="SemiBold" Foreground="#6A6A75" Margin="0,0,0,8" />
                    <CheckBox Grid.Row="2" x:Name="SameForAllCheckBox" Content="Same wallpaper on every monitor"
                              Margin="0,0,0,8" Checked="SameForAllCheckBox_Changed" Unchecked="SameForAllCheckBox_Changed" />
                    <ListBox Grid.Row="3" x:Name="MonitorList" Background="#FBFBFC" BorderBrush="#E1E1E6"
                             SelectionChanged="MonitorList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding StatusLine}" FontSize="11" Foreground="#6A6A75" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Editor -->
            <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E1E1E6" BorderThickness="1" CornerRadius="6" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="EditorHeaderTextBlock" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" Text="Wallpaper" />

                        <TextBlock Text="Source" FontSize="11" FontWeight="SemiBold" Foreground="#6A6A75" />
                        <ComboBox x:Name="SourceKindComboBox" Margin="0,4,0,12" SelectionChanged="SourceKindComboBox_SelectionChanged">
                            <ComboBoxItem Content="Solid colour" Tag="SolidColor" />
                            <ComboBoxItem Content="Image file" Tag="Image" />
                            <ComboBoxItem Content="Slideshow folder" Tag="Slideshow" />
                            <ComboBoxItem Content="Video file" Tag="Video" />
                            <ComboBoxItem Content="Video folder" Tag="VideoFolder" />
                        </ComboBox>

                        <TextBlock x:Name="PathLabelTextBlock" Text="File" FontSize="11" FontWeight="SemiBold" Foreground="#6A6A75" />
                        <Grid Margin="0,4,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PathTextBox" Grid.Column="0" Padding="6,4" VerticalContentAlignment="Center"
                                     LostFocus="PathTextBox_LostFocus" />
                            <Button Grid.Column="1" Content="Browse…" Width="94" Margin="8,0,0,0" Padding="8,4" Click="Browse_Click" />
                        </Grid>

                        <Button x:Name="NextItemButton" Content="Skip to the next picture / video" Width="240"
                                HorizontalAlignment="Left" Margin="0,0,0,12" Padding="8,4" Click="NextItem_Click" />

                        <TextBlock Text="Scaling" FontSize="11" FontWeight="SemiBold" Foreground="#6A6A75" />
                        <ComboBox x:Name="StretchComboBox" Margin="0,4,0,12" SelectionChanged="StretchComboBox_Changed">
                            <ComboBoxItem Content="Fill (crop, no distortion)" Tag="Fill" />
                            <ComboBoxItem Content="Fit (letterbox)" Tag="Fit" />
                            <ComboBoxItem Content="Stretch (may distort)" Tag="Stretch" />
                            <ComboBoxItem Content="Original size, centred" Tag="Center" />
                        </ComboBox>

                        <StackPanel x:Name="SlideshowPanel" Margin="0,0,0,12">
                            <TextBlock Text="SLIDESHOW" FontSize="11" FontWeight="SemiBold" Foreground="#6A6A75" />
                            <CheckBox x:Name="SubfoldersCheckBox" Content="Include subfolders" Margin="0,6,0,0"
                                      Checked="EditorOption_Changed" Unchecked="EditorOption_Changed" />
                            <CheckBox x:Name="ShuffleCheckBox" Content="Shuffle order (random sequence)" Margin="0,6,0,0"
                                      Checked="EditorOption_Changed" Unchecked="EditorOption_Changed" />
                            <TextBlock x:Name="IntervalValueTextBlock" Text="Change every 30 seconds" Margin="0,10,0,2" />
                            <Slider x:Name="IntervalSlider" Minimum="5" Maximum="600" Value="30" TickFrequency="5"
                                    IsSnapToTickEnabled="True" ValueChanged="IntervalSlider_ValueChanged" />
                        </StackPanel>

                        <StackPanel x:Name="VideoPanel" Margin="0,0,0,12">
                            <TextBlock Text="VIDEO" FontSize="11" FontWeight="SemiBold" Foreground="#6A6A75" />
                            <CheckBox x:Name="MuteCheckBox" Content="Mute audio" Margin="0,6,0,0"
                                      Checked="MuteCheckBox_Changed" Unchecked="MuteCheckBox_Changed" />
                            <TextBlock x:Name="VolumeValueTextBlock" Text="Volume 0%" Margin="0,10,0,2" />
                            <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="0" TickFrequency="5"
                                    IsSnapToTickEnabled="True" ValueChanged="VolumeSlider_ValueChanged" />
                        </StackPanel>

                        <StackPanel x:Name="VideoFolderPanel" Margin="0,0,0,12">
                            <TextBlock Text="VIDEO FOLDER" FontSize="11" FontWeight="SemiBold" Foreground="#6A6A75" />
                            <ComboBox x:Name="VideoOrderComboBox" Margin="0,6,0,0" SelectionChanged="EditorOption_Changed">
                                <ComboBoxItem Content="Sequential (name order, then start again)" Tag="Sequential" />
                                <ComboBoxItem Content="Random sequence (every clip once, reshuffled)" Tag="ShuffledSequence" />
                                <ComboBoxItem Content="Random loop (one random clip, looped)" Tag="SingleRandomLoop" />
                            </ComboBox>
                            <CheckBox x:Name="VideoSubfoldersCheckBox" Content="Include subfolders" Margin="0,8,0,0"
                                      Checked="EditorOption_Changed" Unchecked="EditorOption_Changed" />
                        </StackPanel>

                        <StackPanel x:Name="ColorPanel" Margin="0,0,0,12">
                            <TextBlock Text="BACKGROUND COLOUR" FontSize="11" FontWeight="SemiBold" Foreground="#6A6A75" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Border x:Name="ColorPreviewBorder" Width="28" Height="26" Background="#000000" BorderBrush="#C9C9D1" BorderThickness="1" />
                                <TextBox x:Name="ColorTextBox" Text="#000000" Width="140" Margin="8,0,0,0" Padding="6,4"
                                         VerticalContentAlignment="Center" TextChanged="ColorTextBox_TextChanged" />
                                <Button Content="Pick…" Width="84" Margin="8,0,0,0" Padding="8,4" Click="PickColor_Click" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="PAUSE WHEN A MONITOR IS COVERED" FontSize="11" FontWeight="SemiBold" Foreground="#6A6A75" Margin="0,4,0,6" />
                        <CheckBox x:Name="PauseMaximizedCheckBox" Content="Pause a monitor that shows a maximized window" />
                        <CheckBox x:Name="PauseFullscreenCheckBox" Content="Pause every monitor while a fullscreen app has the focus" Margin="0,6,0,0" />

                        <TextBlock Text="STARTUP" FontSize="11" FontWeight="SemiBold" Foreground="#6A6A75" Margin="0,16,0,6" />
                        <CheckBox x:Name="StartWithWindowsCheckBox" Content="Start with Windows (current user)"
                                  Checked="StartWithWindowsCheckBox_Changed" Unchecked="StartWithWindowsCheckBox_Changed" />
                        <CheckBox x:Name="StartMinimizedCheckBox" Content="Start hidden in the notification area" Margin="0,6,0,0" />
                        <Button Content="Open settings folder" HorizontalAlignment="Left" Width="176" Margin="0,12,0,0" Padding="8,4" Click="OpenFolder_Click" />

                        <TextBlock Text="COMPATIBILITY" FontSize="11" FontWeight="SemiBold" Foreground="#6A6A75" Margin="0,16,0,6" />
                        <ComboBox x:Name="RendererComboBox" Width="360" HorizontalAlignment="Left"
                                  SelectionChanged="RendererComboBox_SelectionChanged">
                            <ComboBoxItem Content="DirectComposition (recommended)" />
                            <ComboBoxItem Content="WPF, hardware rendering (older builds)" />
                            <ComboBoxItem Content="WPF, software rendering (older builds)" />
                        </ComboBox>
                        <ComboBox x:Name="WallpaperScaleComboBox" Width="360" HorizontalAlignment="Left" Margin="0,6,0,0"
                                  SelectionChanged="WallpaperScaleComboBox_SelectionChanged">
                            <ComboBoxItem Content="Wallpaper scale: pixels as DIPs (no DPI adjustment) — default" Tag="Pixels" />
                            <ComboBoxItem Content="Wallpaper scale: match the display scaling" Tag="MatchDisplayScaling" />
                            <ComboBoxItem Content="Wallpaper scale: assume a 150 % display" Tag="AssumeOneHundredFiftyPercent" />
                        </ComboBox>
                        <TextBlock FontSize="11" Foreground="#6A6A75" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="DirectComposition is the only stack Windows 11 24H2 and newer composes into the desktop. The WPF modes only work on older builds. Takes effect after a restart." />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Restart LiveWall" Width="140" Padding="8,4" Click="Restart_Click" />
                            <Button Content="Check what the desktop shows" Width="220" Margin="8,0,0,0" Padding="8,4" Click="Recheck_Click" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E1E1E6" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock x:Name="EngineStateTextBlock" Text="Engine stopped" FontWeight="SemiBold" />
                <TextBlock x:Name="StatusTextBlock" Text="" Foreground="#6A6A75" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
