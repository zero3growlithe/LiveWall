<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>LiveWall</AssemblyName>
    <RootNamespace>LiveWall</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>2.2.0</Version>
    <AssemblyTitle>LiveWall</AssemblyTitle>
    <Product>LiveWall</Product>
    <Description>Lightweight animated desktop wallpaper host: per-monitor images, slideshows and videos that pause when a monitor is covered.</Description>
  </PropertyGroup>

  <!-- DirectComposition renderer: D3D11 flip-model swapchains on a DComp visual tree. WPF cannot
       present into the shell's composition on Windows 11 24H2+ (build 26100 and newer). -->
  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
  </ItemGroup>

  <!-- Build fingerprint for crash.log ("build: <sha>") - GITHUB_SHA is set only on CI builds. -->
  <Target Name="WriteBuildInfo" AfterTargets="PrepareForBuild">
    <WriteLinesToFile File="$(IntermediateOutputPath)BuildInfo.g.cs"
                      Lines="namespace LiveWall { internal static class BuildInfo { public const string Sha = &quot;$(GITHUB_SHA)&quot;%3B } }"
                      Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)BuildInfo.g.cs" />
    </ItemGroup>
  </Target>

</Project>
