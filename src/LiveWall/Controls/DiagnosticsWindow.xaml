<Window x:Class="LiveWall.Controls.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LiveWall diagnostics"
        Height="560"
        Width="780"
        MinHeight="400"
        MinWidth="620"
        Background="#F7F7F9"
        Foreground="#1E1E22"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Refresh" Width="90" Padding="8,4" Click="Refresh_Click" />
            <Button Content="Copy" Width="90" Padding="8,4" Margin="8,0,0,0" Click="Copy_Click" />
            <Button x:Name="TestVisibilityButton" Content="Test visibility" Width="120" Padding="8,4" Margin="8,0,0,0" Click="TestVisibility_Click" />
            <Button Content="Open log folder" Width="130" Padding="8,4" Margin="8,0,0,0" Click="OpenLogFolder_Click" />
            <Button Content="Close" Width="90" Padding="8,4" Margin="8,0,0,0" HorizontalAlignment="Right" IsCancel="True" Click="Close_Click" />
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#C9C9D1" BorderThickness="1" Background="#FFFFFF">
            <TextBox x:Name="ReportTextBox"
                     IsReadOnly="True"
                     IsReadOnlyCaretVisible="False"
                     FontFamily="Consolas"
                     FontSize="11"
                     Padding="8"
                     BorderThickness="0"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap" />
        </Border>

        <TextBlock x:Name="ResultTextBlock"
                   Grid.Row="2"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   Foreground="#3A3A42" />
    </Grid>
</Window>
