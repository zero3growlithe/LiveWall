<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark palette. Every key in this file must also exist in the other palette with the same
         spelling: ThemeManager swaps the whole dictionary at runtime, so a key that is present here and
         missing there throws the moment the user switches the theme. Add brushes to BOTH files. -->

    <SolidColorBrush x:Key="WindowBackground" Color="#1B1B1F" />
    <SolidColorBrush x:Key="PanelBackground" Color="#232329" />
    <SolidColorBrush x:Key="PanelBorder" Color="#33333B" />
    <SolidColorBrush x:Key="ListBackground" Color="#26262D" />
    <SolidColorBrush x:Key="TextPrimary" Color="#ECECF1" />
    <SolidColorBrush x:Key="TextSecondary" Color="#A3A3AF" />
    <SolidColorBrush x:Key="TextMuted" Color="#7C7C88" />
    <SolidColorBrush x:Key="InputBackground" Color="#1D1D22" />
    <SolidColorBrush x:Key="InputBorder" Color="#3C3C46" />
    <SolidColorBrush x:Key="InputReadOnlyBackground" Color="#202027" />
    <SolidColorBrush x:Key="ControlBackground" Color="#2A2A31" />
    <SolidColorBrush x:Key="ControlBorder" Color="#3C3C46" />
    <SolidColorBrush x:Key="ControlHoverBackground" Color="#34343D" />
    <SolidColorBrush x:Key="ControlPressedBackground" Color="#3E3E49" />
    <SolidColorBrush x:Key="ControlDisabledBackground" Color="#26262C" />
    <SolidColorBrush x:Key="ControlDisabledText" Color="#70707C" />
    <SolidColorBrush x:Key="AccentBackground" Color="#5A8DF8" />
    <SolidColorBrush x:Key="AccentText" Color="#0E1420" />
    <SolidColorBrush x:Key="SelectionBackground" Color="#2F4B85" />
    <SolidColorBrush x:Key="SelectionText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HoverBackground" Color="#2E2E36" />
    <SolidColorBrush x:Key="TrackBackground" Color="#3A3A44" />
    <SolidColorBrush x:Key="ThumbBackground" Color="#C9C9D4" />
    <SolidColorBrush x:Key="ThumbHoverBackground" Color="#E4E9F7" />
    <SolidColorBrush x:Key="ThumbBorder" Color="#55555F" />
    <SolidColorBrush x:Key="CheckBoxBorder" Color="#55555F" />
    <SolidColorBrush x:Key="CheckMark" Color="#7DA3FF" />
    <SolidColorBrush x:Key="Separator" Color="#33333B" />
    <SolidColorBrush x:Key="MenuBackground" Color="#232329" />
    <SolidColorBrush x:Key="MenuBorder" Color="#3C3C46" />
    <SolidColorBrush x:Key="ToolTipBackground" Color="#2E2E36" />
    <SolidColorBrush x:Key="ToolTipBorder" Color="#4A4A55" />

    <!-- The system brushes stock templates fall back to (scrollbar internals, a ComboBox
         edit box, native tooltips, a stray Panel). Left alone they stay white in a dark
         window, because they do not read the palette. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1B1B1F" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#ECECF1" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#2A2A31" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#ECECF1" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#7C7C88" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#5A8DF8" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0E1420" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#2E2E36" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#ECECF1" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#232329" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#ECECF1" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="#2E2E36" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="#ECECF1" />

</ResourceDictionary>
